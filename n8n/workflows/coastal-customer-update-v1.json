{
  "id": "coastal-customer-update-v1",
  "name": "Demo \u2014 Customer State Update",
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "demo-customer-update",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "customer-update-webhook",
      "name": "Customer Update Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "wh-coastal-customer-update-v1"
    },
    {
      "parameters": {
        "method": "POST",
